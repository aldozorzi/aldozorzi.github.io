<script is:inline>
  (function() {
    var themes = {
      catppuccin: { mode: "dark", background: "#1e1e2e", muted: "#585b70", foreground: "#cdd6f4", brightForeground: "#cdd6f4", accent: "#89b4fa" },
      "catppuccin-latte": { mode: "light", background: "#eff1f5", muted: "#acb0be", foreground: "#4c4f69", brightForeground: "#4c4f69", accent: "#1e66f5" },
      ethereal: { mode: "dark", background: "#060B1E", muted: "#6d7db6", foreground: "#ffcead", brightForeground: "#ffcead", accent: "#7d82d9" },
      everforest: { mode: "dark", background: "#2d353b", muted: "#475258", foreground: "#d3c6aa", brightForeground: "#d3c6aa", accent: "#7fbbb3" },
      "flexoki-light": { mode: "light", background: "#FFFCF0", muted: "#B7B5AC", foreground: "#100F0F", brightForeground: "#100F0F", accent: "#205EA6" },
      gruvbox: { mode: "dark", background: "#282828", muted: "#665c54", foreground: "#d4be98", brightForeground: "#d4be98", accent: "#7daea3" },
      hackerman: { mode: "dark", background: "#0B0C16", muted: "#2d3450", foreground: "#ddf7ff", brightForeground: "#ddf7ff", accent: "#82FB9C" },
      kanagawa: { mode: "dark", background: "#1f1f28", muted: "#54546D", foreground: "#dcd7ba", brightForeground: "#dcd7ba", accent: "#dcd7ba" },
      "last-horizon": { mode: "dark", background: "#0c0b0c", muted: "#584e51", foreground: "#FAFCFB", brightForeground: "#e2dddc", accent: "#b59790" },
      lumon: { mode: "dark", background: "#16242d", muted: "#304860", foreground: "#d6e2ee", brightForeground: "#f2fcff", accent: "#8bc9eb" },
      lupine: { mode: "light", background: "#fafafa", muted: "#9e9e9e", foreground: "#212121", brightForeground: "#000000", accent: "#3264eb" },
      "matte-black": { mode: "dark", background: "#121212", muted: "#333333", foreground: "#bebebe", brightForeground: "#bebebe", accent: "#e68e0d" },
      miasma: { mode: "dark", background: "#222222", muted: "#666666", foreground: "#c2c2b0", brightForeground: "#c2c2b0", accent: "#78824b" },
      nord: { mode: "dark", background: "#2e3440", muted: "#4c566a", foreground: "#d8dee9", brightForeground: "#d8dee9", accent: "#81a1c1" },
      "osaka-jade": { mode: "dark", background: "#111c18", muted: "#53685B", foreground: "#C1C497", brightForeground: "#F7E8B2", accent: "#509475" },
      "retro-82": { mode: "dark", background: "#05182e", muted: "#2a6b78", foreground: "#f6dcac", brightForeground: "#f6dcac", accent: "#faa968" },
      ristretto: { mode: "dark", background: "#2c2525", muted: "#72696a", foreground: "#e6d9db", brightForeground: "#e6d9db", accent: "#f38d70" },
      "rose-pine": { mode: "light", background: "#faf4ed", muted: "#cecacd", foreground: "#575279", brightForeground: "#575279", accent: "#56949f" },
      solitude: { mode: "dark", background: "#101315", muted: "#4b4e55", foreground: "#cacccc", brightForeground: "#a5aeb4", accent: "#798186" },
      "tokyo-night": { mode: "dark", background: "#1a1b26", muted: "#414868", foreground: "#a9b1d6", brightForeground: "#c0caf5", accent: "#7aa2f7" },
      vantablack: { mode: "dark", background: "#000000", muted: "#7a7a7a", foreground: "#ffffff", brightForeground: "#ffffff", accent: "#8d8d8d" },
      white: { mode: "light", background: "#ffffff", muted: "#808080", foreground: "#000000", brightForeground: "#000000", accent: "#6e6e6e" }
    };
    var STORAGE_KEY = "ldazrz-theme";
    var EXPIRY_HOURS = 12;
    var currentTheme = null;

    function getStoredTheme() {
      try {
        var stored = localStorage.getItem(STORAGE_KEY);
        if (!stored) return null;
        var parsed = JSON.parse(stored);
        if (Date.now() - parsed.timestamp > EXPIRY_HOURS * 3600000) {
          localStorage.removeItem(STORAGE_KEY);
          return null;
        }
        return parsed.name;
      } catch (e) { return null; }
    }

    function storeTheme(name) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ name: name, timestamp: Date.now() }));
    }

    function getRandomTheme() {
      var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      var filtered = Object.keys(themes).filter(function(k) { return themes[k].mode === (prefersDark ? "dark" : "light"); });
      return filtered[Math.floor(Math.random() * filtered.length)];
    }

    function applyTheme(name) {
      currentTheme = name;
      var t = themes[name];
      var r = document.documentElement;
      r.style.setProperty("--theme-background", t.background);
      r.style.setProperty("--theme-muted", t.muted);
      r.style.setProperty("--theme-foreground", t.foreground);
      r.style.setProperty("--theme-bright-foreground", t.brightForeground);
      r.style.setProperty("--theme-accent", t.accent);
      storeTheme(name);
      updatePickerHighlight(name);
    }

    function updatePickerHighlight(name) {
      var items = document.querySelectorAll("[data-theme-item]");
      items.forEach(function(item) {
        var isSelected = item.getAttribute("data-theme-item") === name;
        item.classList.toggle("bg-foreground/10", isSelected);
        item.classList.toggle("text-bright-foreground", isSelected);
      });
    }

    var stored = getStoredTheme();
    currentTheme = stored || getRandomTheme();
    if (!stored) storeTheme(currentTheme);

    var t = themes[currentTheme];
    var r = document.documentElement;
    r.style.setProperty("--theme-background", t.background);
    r.style.setProperty("--theme-muted", t.muted);
    r.style.setProperty("--theme-foreground", t.foreground);
    r.style.setProperty("--theme-bright-foreground", t.brightForeground);
    r.style.setProperty("--theme-accent", t.accent);

    window._themeData = {
      themes: themes,
      get currentTheme() { return currentTheme; },
      applyTheme: applyTheme
    };
  })();
</script>

<div
  id="theme-picker"
  class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm"
>
  <div
    data-theme-panel
    class="bg-background border border-muted/30 rounded-xl shadow-2xl w-full max-w-md mx-4 transform scale-95 opacity-0 transition-all duration-200"
  >
    <div class="flex items-center justify-between px-4 py-3 border-b border-muted/30">
      <h3 class="font-sans text-sm font-semibold uppercase tracking-wider text-foreground">
        Select Theme
      </h3>
      <button
        id="theme-picker-close"
        class="text-muted hover:text-foreground transition-colors"
        aria-label="Close theme picker"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <ul
      id="theme-list"
      class="max-h-80 overflow-y-auto p-2 space-y-1 font-sans text-sm text-foreground"
    >
    </ul>
    <div class="px-4 py-2 border-t border-muted/30 text-[11px] text-muted text-center">
      <span class="opacity-70">↑↓ navigate</span>
      <span class="mx-2">·</span>
      <span class="opacity-70">enter select</span>
      <span class="mx-2">·</span>
      <span class="opacity-70">esc close</span>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    var picker = document.getElementById("theme-picker");
    var list = document.getElementById("theme-list");
    var isOpen = false;
    var selectedIndex = -1;
    var items = [];

    function openPicker() {
      if (isOpen) return;
      isOpen = true;
      picker.classList.remove("hidden");
      picker.classList.add("flex");
      requestAnimationFrame(function() {
        picker.querySelector("[data-theme-panel]").classList.add("scale-100", "opacity-100");
        picker.querySelector("[data-theme-panel]").classList.remove("scale-95", "opacity-0");
      });
      buildList();
      if (selectedIndex >= 0) selectItem(selectedIndex);
      document.addEventListener("keydown", handleKey);
    }

    function closePicker() {
      if (!isOpen) return;
      isOpen = false;
      picker.querySelector("[data-theme-panel]").classList.remove("scale-100", "opacity-100");
      picker.querySelector("[data-theme-panel]").classList.add("scale-95", "opacity-0");
      setTimeout(function() {
        picker.classList.add("hidden");
        picker.classList.remove("flex");
      }, 200);
      document.removeEventListener("keydown", handleKey);
    }

    function togglePicker() {
      isOpen ? closePicker() : openPicker();
    }

    function buildList() {
      list.innerHTML = "";
      items = [];
      selectedIndex = -1;
      var data = window._themeData;
      var themeNames = Object.keys(data.themes).sort();
      themeNames.forEach(function(name, i) {
        var t = data.themes[name];
        var li = document.createElement("li");
        li.setAttribute("data-theme-item", name);
        li.setAttribute("tabindex", "-1");
        li.className = "px-3 py-2 cursor-pointer rounded transition-colors hover:bg-foreground/10 text-foreground flex items-center gap-2";
        
        var swatch = document.createElement("span");
        swatch.className = "w-3 h-3 rounded-full border border-foreground/20 flex-shrink-0";
        swatch.style.backgroundColor = t.background;
        
        var label = document.createElement("span");
        label.textContent = name.replace(/-/g, " ");
        label.className = "flex-1";
        
        var modeBadge = document.createElement("span");
        modeBadge.textContent = t.mode;
        modeBadge.className = "text-[10px] uppercase tracking-wider opacity-50";
        
        li.appendChild(swatch);
        li.appendChild(label);
        li.appendChild(modeBadge);
        
        if (name === data.currentTheme) {
          li.classList.add("bg-foreground/10", "text-bright-foreground");
          selectedIndex = i;
        }
        
        li.addEventListener("click", function() {
          data.applyTheme(name);
        });
        
        li.addEventListener("mouseenter", function() {
          highlightItem(i);
        });
        
        list.appendChild(li);
        items.push(li);
      });
    }

    function highlightItem(index) {
      if (selectedIndex >= 0 && items[selectedIndex]) {
        items[selectedIndex].classList.remove("bg-foreground/10", "text-bright-foreground");
      }
      selectedIndex = index;
      if (items[selectedIndex]) {
        items[selectedIndex].classList.add("bg-foreground/10", "text-bright-foreground");
        items[selectedIndex].scrollIntoView({ block: "nearest" });
      }
    }

    function selectItem(index) {
      highlightItem(index);
      if (items[selectedIndex]) {
        var name = items[selectedIndex].getAttribute("data-theme-item");
        window._themeData.applyTheme(name);
      }
    }

    function handleKey(e) {
      if (!isOpen) return;
      
      if (e.key === "Escape") {
        e.preventDefault();
        closePicker();
        return;
      }
      
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (selectedIndex < items.length - 1) {
          selectItem(selectedIndex + 1);
        }
        return;
      }
      
      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (selectedIndex > 0) {
          selectItem(selectedIndex - 1);
        }
        return;
      }
      
      if (e.key === "Enter" && selectedIndex >= 0) {
        e.preventDefault();
        var name = items[selectedIndex].getAttribute("data-theme-item");
        window._themeData.applyTheme(name);
        closePicker();
      }
    }

    document.addEventListener("keydown", function(e) {
      if (e.metaKey && e.ctrlKey && e.key === "t") {
        e.preventDefault();
        togglePicker();
      }
    });

    picker.addEventListener("click", function(e) {
      if (e.target === picker) {
        closePicker();
      }
    });

    document.getElementById("theme-picker-close").addEventListener("click", function() {
      closePicker();
    });

    window._themePicker = { open: openPicker, close: closePicker, toggle: togglePicker };
  });
</script>
