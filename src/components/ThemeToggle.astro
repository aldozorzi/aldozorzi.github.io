---
---

<button
  id="theme-open-picker"
  class="fixed top-4 right-12 z-40 p-2 text-foreground hover:text-bright-foreground transition-colors"
  aria-label="Open theme picker"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
  </svg>
</button>

<button
  id="theme-toggle"
  class="fixed top-4 right-4 z-40 p-2 text-foreground hover:text-bright-foreground transition-colors"
  aria-label="Toggle dark/light theme"
>
  <svg id="theme-toggle-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
  </svg>
  <svg id="theme-toggle-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
  </svg>
</button>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    var btn = document.getElementById("theme-toggle");
    var pickerBtn = document.getElementById("theme-open-picker");
    var sunIcon = document.getElementById("theme-toggle-sun");
    var moonIcon = document.getElementById("theme-toggle-moon");
    var DARK_DEFAULT = "coffee";
    var LIGHT_DEFAULT = "flexoki-light";
    var STORAGE_KEY = "ldazrz-theme";
    var currentDark = DARK_DEFAULT;
    var currentLight = LIGHT_DEFAULT;

    try {
      var stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        var parsed = JSON.parse(stored);
        if (parsed.darkTheme) currentDark = parsed.darkTheme;
        if (parsed.lightTheme) currentLight = parsed.lightTheme;
      }
    } catch (e) {}

    var data = window._themeData;
    if (data) {
      var mode = data.themes[data.currentTheme].mode;
      if (mode === "dark") {
        currentDark = data.currentTheme;
      } else {
        currentLight = data.currentTheme;
      }
    }

    function updateIcon() {
      var data = window._themeData;
      if (!data) return;
      var mode = data.themes[data.currentTheme].mode;
      if (mode === "dark") {
        currentDark = data.currentTheme;
        sunIcon.classList.remove("hidden");
        moonIcon.classList.add("hidden");
      } else {
        currentLight = data.currentTheme;
        moonIcon.classList.remove("hidden");
        sunIcon.classList.add("hidden");
      }
    }

    if (data) {
      var originalApply = data.applyTheme;
      data.applyTheme = function(name) {
        originalApply(name);
        updateIcon();
      };
    }

    pickerBtn.addEventListener("click", function() {
      window._themePicker.open();
    });

    btn.addEventListener("click", function() {
      var data = window._themeData;
      if (!data) return;
      var mode = data.themes[data.currentTheme].mode;
      if (mode === "dark") {
        data.applyTheme(currentLight);
      } else {
        data.applyTheme(currentDark);
      }
    });

    updateIcon();
  });
</script>
